rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn()
        && request.auth.uid == uid;
    }

    function isAdmin() {
      return isSignedIn()
        && exists(
          /databases/$(database)/documents/userProfiles/$(request.auth.uid)
        )
        && get(
          /databases/$(database)/documents/userProfiles/$(request.auth.uid)
        ).data.get('isAdmin', false) == true;
    }

    function hasActiveSubscription(data) {
      return data.get('subscriptionActive', false) == true
        && data.get('subscriptionStatus', '') in [
          'active',
          'trialing'
        ];
    }

    // NEW: trial users have trialActive == true and trialEndsAt in the future
    function isTrialing(data) {
      return data.get('trialActive', false) == true
        && data.get('trialEndsAt', null) is timestamp
        && data.get('trialEndsAt').toMillis() > request.time.toMillis();
    }

    function protectedServerFields() {
      return [
        'isAdmin',
        'stripeCustomerId',
        'stripeSubscriptionId',
        'stripeSubscriptionItemId',
        'checkoutSessionId',
        'stripePriceId',
        'subscriptionStatus',
        'subscriptionActive',
        'subscriptionCurrentPeriodEnd',
        'subscriptionCancelAtPeriodEnd',
        'subscriptionCreatedAt',
        'subscriptionUpdatedAt',
        'lastPaymentStatus',
        'lastPaymentAt',
        // NEW: trial fields set by Cloud Functions, not writable by users
        'trialActive',
        'trialEndsAt',
        'trialReminderSent'
      ];
    }

    function hasNoServerFieldsOnCreate() {
      return !request.resource.data.keys().hasAny(
        protectedServerFields()
      );
    }

    function hasNoServerFieldChanges() {
      return !request.resource.data
        .diff(resource.data)
        .affectedKeys()
        .hasAny(protectedServerFields());
    }

    function validProfileFields(uid) {
      let data = request.resource.data;

      return data.get('uid', uid) == uid
        && data.get('uid', uid) is string

        && data.get('name', '') is string
        && data.get('name', '').size() > 0
        && data.get('name', '').size() <= 100

        && data.get('companyName', '') is string
        && data.get('companyName', '').size() <= 150

        && data.get('email', '') is string
        && data.get('email', '').size() <= 254

        && data.get('vacationAllowed', 30) is number

        && data.get('workSessions', []) is list
        && data.get('workSessions', []).size() <= 5000

        && data.get('leaveDays', []) is list
        && data.get('leaveDays', []).size() <= 2000

        && data.get('trash', []) is list
        && data.get('trash', []).size() <= 2000;
    }

    function validProfileCreate(uid) {
      return validProfileFields(uid)
        && hasNoServerFieldsOnCreate();
    }

    function validProfileUpdate(uid) {
      return validProfileFields(uid)
        && request.resource.data.get('uid', uid) == uid
        && hasNoServerFieldChanges();
    }

    match /userProfiles/{uid} {
      // Pending users must read their profile to check payment state.
      allow get: if isOwner(uid) || isAdmin();
      allow list: if isAdmin();

      // Registration creates a pending profile without billing fields.
      allow create: if isOwner(uid)
        && validProfileCreate(uid);

      // CHANGED: allow active subscribers OR trial users to write
      allow update: if (
          isOwner(uid)
          && (
            hasActiveSubscription(resource.data)
            || isTrialing(resource.data)
          )
          && validProfileUpdate(uid)
        ) || (
          isAdmin()
          && hasNoServerFieldChanges()
          && validProfileFields(uid)
        );

      allow delete: if false;
    }

    match /userDevices/{deviceDocument} {
      allow get, list: if isSignedIn()
        && (
          resource.data.user == request.auth.uid
          || isAdmin()
        );

      allow create: if isSignedIn()
        && (
          (
            request.resource.data.user == request.auth.uid
            && (
              hasActiveSubscription(
                get(
                  /databases/$(database)/documents/userProfiles/$(request.auth.uid)
                ).data
              )
              || isTrialing(
                get(
                  /databases/$(database)/documents/userProfiles/$(request.auth.uid)
                ).data
              )
            )
            && request.resource.data.deviceId is string
            && request.resource.data.deviceId.size() > 0
            && request.resource.data.deviceId.size() <= 200
            && request.resource.data.name is string
            && request.resource.data.name.size() > 0
            && request.resource.data.name.size() <= 100
          )
          || isAdmin()
        );

      allow update: if isSignedIn()
        && (
          (
            resource.data.user == request.auth.uid
            && request.resource.data.user
              == resource.data.user
            && request.resource.data.deviceId
              == resource.data.deviceId
            && request.resource.data.name is string
            && request.resource.data.name.size() > 0
            && request.resource.data.name.size() <= 100
            && (
              hasActiveSubscription(
                get(
                  /databases/$(database)/documents/userProfiles/$(request.auth.uid)
                ).data
              )
              || isTrialing(
                get(
                  /databases/$(database)/documents/userProfiles/$(request.auth.uid)
                ).data
              )
            )
          )
          || isAdmin()
        );

      allow delete: if isSignedIn()
        && (
          resource.data.user == request.auth.uid
          || isAdmin()
        );
    }

    match /feedback/{feedbackId} {
      allow create: if isSignedIn()
        && request.resource.data.keys().hasOnly([
          'uid',
          'name',
          'message',
          'createdAt'
        ])
        && request.resource.data.uid
          == request.auth.uid
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 100
        && request.resource.data.message is string
        && request.resource.data.message.size() > 0
        && request.resource.data.message.size() <= 4000
        && request.resource.data.createdAt is timestamp;

      allow read: if isAdmin();
      allow update, delete: if false;
    }

    match /adminNotes/{noteDocument} {
      allow read, write: if isAdmin();
    }

    match /allEmployees/{employeeDocument} {
      allow read, write: if isAdmin();
    }

    match /stripeWebhookEvents/{eventId} {
      allow read, write: if false;
    }

    match /stripeCustomers/{document=**} {
      allow read, write: if false;
    }

    match /stripeSubscriptions/{document=**} {
      allow read, write: if false;
    }

    match /stripeInvoices/{document=**} {
      allow read, write: if false;
    }

    // OTP codes are managed exclusively by Cloud Functions (Admin SDK).
    // No client access allowed — codes auto-expire after 10 minutes.
    match /otpCodes/{email} {
      allow read, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
